# Backend API base URL (Express server)
VITE_API_URL=http://localhost:5000/api
# Optional: Socket.IO server URL (defaults to VITE_API_URL without /api)
VITE_SOCKET_URL=

# Map: Leaflet + OpenStreetMap tiles (no key needed).
# Optional: use your own tile server/provider in production (OSM's public tiles are for light use only).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Firebase web app config (public identifiers, not secrets) for push notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
