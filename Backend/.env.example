# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed by CORS / Socket.IO
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB Atlas) ----------
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saferouteai?retryWrites=true&w=majority
MONGODB_URI=
# Optional: custom DNS servers if your network cannot resolve Atlas SRV records
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# ---------- Auth ----------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Required to create admin accounts from /admin/register. Leave empty to disable admin sign-up.
ADMIN_REGISTRATION_CODE=

# ---------- Map data ----------
# By default the free OpenStreetMap services below are used (no key needed):
#   Photon = place search / reverse geocoding, OSRM = routes, Overpass = nearby services
PHOTON_API_URL=https://photon.komoot.io
OSRM_API_URL=https://routing.openstreetmap.de
# Optional: set a Mapbox token to use Mapbox for search, routes and places instead
MAPBOX_ACCESS_TOKEN=

# ---------- Google Gemini (AI assistant) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- Firebase Admin SDK (push notifications) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key in quotes with literal \n line breaks
FIREBASE_PRIVATE_KEY=
# Web Push certificate key pair (Firebase console > Project settings > Cloud Messaging)
FCM_WEB_VAPID_KEY=

# ---------- Weather / places ----------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OVERPASS_API_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# ---------- Tracking tuning (optional) ----------
ALERT_COOLDOWN_MINUTES=5
NEARBY_ZONE_METERS=500
ROUTE_DEVIATION_METERS=250
LOCATION_MIN_INTERVAL_SECONDS=15
LOCATION_MIN_DISTANCE_METERS=25
LOCATION_RETENTION_DAYS=30
